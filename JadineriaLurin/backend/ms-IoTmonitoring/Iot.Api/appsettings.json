{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=ms_iot;Username=postgres;Password=postgres"
  },
  "Mqtt": {
    "Enabled": true,
    "Host": "localhost",
    "Port": 1883,
    "Username": "",
    "Password": "",
    "KeepAliveSeconds": 60,
    "ReconnectDelaySeconds": 5,
    "ClientId": "ms-iot",
    "TelemetryTopicFilter": "iot/telemetry/+",
    "LastWillTopicFilter": "iot/lastwill/+",
    "SweepIntervalSeconds": 300,
    "StaleDeviceSeconds": 300
  },
  "IrrigationApi": {
    "BaseUrl": "http://localhost:5083/",
    "TimeoutSeconds": 10
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:5173"
    ]
  }
}
