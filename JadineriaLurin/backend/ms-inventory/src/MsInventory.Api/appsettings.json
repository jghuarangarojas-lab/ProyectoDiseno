    "PrimaryConnection": "Host=localhost;Port=5432;Database=lurin_smart;Username=postgres;Password=postgre",
    "BackupConnection": "Host=localhost;Port=5432;Database=lurin_smart_backup;Username=postgres;Password=postgre",
    "HealthCheckIntervalSeconds": 15,
    "ConnectTimeoutSeconds": 3
  },
  "FileStorage": {
    "RootPath": "storage",
    "BaseUrl": "/evidence"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "http://localhost:5173" ]
  }
}
